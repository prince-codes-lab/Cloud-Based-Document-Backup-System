# Server
PORT=5000

# The deployed frontend URL (used for CORS and for building password-reset links).
# For local development this is fine as-is.
FRONTEND_URL=http://localhost:5173

# MongoDB — get a free connection string from MongoDB Atlas (see README)
MONGO_URI=

# JWT — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary — from your free Cloudinary dashboard (see README for steps)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP) — used to send password-reset links. See README for a free
# Gmail App Password setup, or a free transactional-email provider like Brevo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
